// MurmurHash3 was written by Austin Appleby, and is placed in the public
// domain. The author hereby disclaims copyright to this source code.

// Note - The x86 and x64 versions do _not_ produce the same results, as the
// algorithms are optimized for their respective platforms. You can still
// compile and run any of them on any platform, but your performance with the
// non-native version will be less than optimal.

#include <stddef.h>  // size_t
#include <stdint.h>

#ifdef __GNUC__
	#define FORCE_INLINE __attribute__((always_inline)) inline
#else
	#define FORCE_INLINE inline
#endif

static FORCE_INLINE uint32_t rotl32(uint32_t x, int8_t r)
{
	return (x << r) | (x >> (32 - r));
}

static FORCE_INLINE uint64_t rotl64(uint64_t x, int8_t r)
{
	return (x << r) | (x >> (64 - r));
}

// Block read - if your platform needs to do endian-swapping or can only
// handle aligned reads, do the conversion here

#define getblock(p, i) (p[i])

// Finalization mix - force all bits of a hash block to avalanche

static FORCE_INLINE uint32_t fmix32(uint32_t h)
{
	h ^= h >> 16;
	h *= 0x85ebca6b;
	h ^= h >> 13;
	h *= 0xc2b2ae35;
	h ^= h >> 16;

	return h;
}

static FORCE_INLINE uint64_t fmix64(uint64_t k)
{
	k ^= k >> 33;
	k *= 0xff51afd7ed558ccdLLU;
	k ^= k >> 33;
	k *= 0xc4ceb9fe1a85ec53LLU;
	k ^= k >> 33;

	return k;
}

void MurmurHash3_x86_32(
	const unsigned char *const restrict key, const size_t len,
	void *const restrict out
)
{
	uint32_t *const restrict dest = out;
	const int nblocks = len / 4;
	const uint32_t c1 = 0xcc9e2d51, c2 = 0x1b873593;
	uint32_t hash = *dest;

	const uint32_t *const blocks = (const uint32_t *)(key + nblocks * 4);

	for (int i = -nblocks; i; i++)
	{
		uint32_t k1 = getblock(blocks, i);

		k1 = rotl32(k1 * c1, 15) * c2;

		hash = rotl32(hash ^ k1, 13);
		hash = hash * 5 + 0xe6546b64;
	}

	const uint8_t *const tail = (const uint8_t *)(key + nblocks * 4);
	uint32_t k1 = 0;

	switch (len & 3)
	{
		/* clang-format off */
	case 3: k1 ^= tail[2] << 16;
	case 2: k1 ^= tail[1] << 8;
	case 1: k1 ^= tail[0] << 0;
		/* clang-format on */
		k1 = rotl32(k1 * c1, 15) * c2;
		hash ^= k1;
	};

	hash ^= len;
	hash = fmix32(hash);

	*dest = hash;
}

void MurmurHash3_x86_128(
	const unsigned char *const restrict key, const size_t len,
	void *const restrict out
)
{
	uint32_t *const restrict dest = out;
	const uint8_t *const restrict data = (const uint8_t *)key;
	const int nblocks = len / 16;

	const uint32_t c1 = 0x239b961b, c2 = 0xab0e9789;
	const uint32_t c3 = 0x38b34ae5, c4 = 0xa1e38b93;
	uint32_t hash0 = dest[0], hash1 = dest[1];
	uint32_t hash2 = dest[2], hash3 = dest[3];

	const uint32_t *const blocks = (const uint32_t *)(data + nblocks * 16);

	for (int i = -nblocks; i; i++)
	{
		uint32_t k1 = getblock(blocks, i * 4 + 0);
		uint32_t k2 = getblock(blocks, i * 4 + 1);
		uint32_t k3 = getblock(blocks, i * 4 + 2);
		uint32_t k4 = getblock(blocks, i * 4 + 3);

		k1 = rotl32(k1 * c1, 15) * c2;
		k2 = rotl32(k2 * c2, 16) * c3;
		k3 = rotl32(k3 * c3, 17) * c4;
		k4 = rotl32(k4 * c4, 18) * c1;

		hash0 = rotl32(hash0 ^ k1, 19) + hash1;
		hash0 = hash0 * 5 + 0x561ccd1b;

		hash1 = rotl32(hash1 ^ k2, 17) + hash2;
		hash1 = hash1 * 5 + 0x0bcaa747;

		hash2 = rotl32(hash2 ^ k3, 15) + hash3;
		hash2 = hash2 * 5 + 0x96cd1c35;

		hash3 = rotl32(hash3 ^ k4, 13) + hash0;
		hash3 = hash3 * 5 + 0x32ac3b17;
	}

	const uint8_t *const tail = (const uint8_t *)(data + nblocks * 16);
	uint32_t k1 = 0, k2 = 0, k3 = 0, k4 = 0;

	switch (len & 15)
	{
		/* clang-format off */
	case 15	: k4 ^= tail[14] << 16;
	case 14	: k4 ^= tail[13] << 8;
	case 13	: k4 ^= tail[12] << 0;
			k4 = rotl32(k4 * c4, 18) * c1;
			hash3 ^= k4;
	case 12	: k3 ^= tail[11] << 24;
	case 11	: k3 ^= tail[10] << 16;
	case 10	: k3 ^= tail[9] << 8;
	case 9	: k3 ^= tail[8] << 0;
			k3 = rotl32(k3 * c3, 17) * c4;
			hash2 ^= k3;
	case 8	: k2 ^= tail[7] << 24;
	case 7	: k2 ^= tail[6] << 16;
	case 6	: k2 ^= tail[5] << 8;
	case 5	: k2 ^= tail[4] << 0;
			k2 = rotl32(k2 * c2, 16) * c3;
			hash1 ^= k2;
	case 4	: k1 ^= tail[3] << 24;
	case 3	: k1 ^= tail[2] << 16;
	case 2	: k1 ^= tail[1] << 8;
	case 1	: k1 ^= tail[0] << 0;
			k1 = rotl32(k1 * c1, 15) * c2;
			hash0 ^= k1;
		/* clang-format on */
	};

	/* clang-format off */
	hash0 ^= len; hash1 ^= len; hash2 ^= len; hash3 ^= len;
	hash0 += hash1; hash0 += hash2; hash0 += hash3;
	hash1 += hash0; hash2 += hash0; hash3 += hash0;
	/* clang-format on */

	hash0 = fmix32(hash0);
	hash1 = fmix32(hash1);
	hash2 = fmix32(hash2);
	hash3 = fmix32(hash3);

	/* clang-format off */
	hash0 += hash1; hash0 += hash2; hash0 += hash3;
	hash1 += hash0; hash2 += hash0; hash3 += hash0;
	/* clang-format on */

	dest[0] = hash0;
	dest[1] = hash1;
	dest[2] = hash2;
	dest[3] = hash3;
}

void MurmurHash3_x64_128(
	const unsigned char *const restrict key, const size_t len,
	void *const restrict out
)
{
	uint64_t *const restrict dest = out;
	const uint8_t *const restrict data = (const uint8_t *)key;
	const int nblocks = len / 16;
	const uint64_t c1 = 0x87c37b91114253d5LLU;
	const uint64_t c2 = 0x4cf5ad432745937fLLU;
	uint64_t hash0 = dest[0], hash1 = dest[1];

	const uint64_t *const blocks = (const uint64_t *)(data);

	for (int i = 0; i < nblocks; i++)
	{
		uint64_t k1 = getblock(blocks, i * 2 + 0);
		uint64_t k2 = getblock(blocks, i * 2 + 1);

		k1 = rotl64(k1 * c1, 31) * c2;
		k2 = rotl64(k2 * c2, 33) * c1;

		hash0 = rotl64(hash0 ^ k1, 27) + hash1;
		hash1 = rotl64(hash1 ^ k2, 31) + hash0;

		hash0 = hash0 * 5 + 0x52dce729;
		hash1 = hash1 * 5 + 0x38495ab5;
	}

	const uint8_t *const tail = (const uint8_t *)(data + nblocks * 16);
	uint64_t k1 = 0, k2 = 0;

	switch (len & 15)
	{
		/* clang-format off */
	case 15	: k2 ^= (uint64_t)(tail[14]) << 48;
	case 14	: k2 ^= (uint64_t)(tail[13]) << 40;
	case 13	: k2 ^= (uint64_t)(tail[12]) << 32;
	case 12	: k2 ^= (uint64_t)(tail[11]) << 24;
	case 11	: k2 ^= (uint64_t)(tail[10]) << 16;
	case 10	: k2 ^= (uint64_t)(tail[9]) << 8;
	case 9	: k2 ^= (uint64_t)(tail[8]) << 0;
			k2 = rotl64(k2 * c2, 33) * c1;
			hash1 ^= k2;
	case 8	: k1 ^= (uint64_t)(tail[7]) << 56;
	case 7	: k1 ^= (uint64_t)(tail[6]) << 48;
	case 6	: k1 ^= (uint64_t)(tail[5]) << 40;
	case 5	: k1 ^= (uint64_t)(tail[4]) << 32;
	case 4	: k1 ^= (uint64_t)(tail[3]) << 24;
	case 3	: k1 ^= (uint64_t)(tail[2]) << 16;
	case 2	: k1 ^= (uint64_t)(tail[1]) << 8;
	case 1	: k1 ^= (uint64_t)(tail[0]) << 0;
			k1 = rotl64(k1 * c1, 31) * c2;
			hash0 ^= k1;
		/* clang-format on */
	};

	hash0 ^= len;
	hash1 ^= len;

	hash0 += hash1;
	hash1 += hash0;

	hash0 = fmix64(hash0);
	hash1 = fmix64(hash1);

	hash0 += hash1;
	hash1 += hash0;

	dest[0] = hash0;
	dest[1] = hash1;
}

