#define DA_CONCAT0(tok0, tok1) tok0##tok1
#define DA_CONCAT(tok0, tok1) DA_CONCAT0(tok0, tok1)

#define DYNAMICARRAY_TAG                                               \
	DA_CONCAT(DynamicArray_, DYNAMICARRAY_UNIQUE_SUFFIX)
#define DYNAMICARRAY_METHODNAME(name)                                         \
	DA_CONCAT(DA_CONCAT(da_, DYNAMICARRAY_UNIQUE_SUFFIX), DA_CONCAT(_, name))

/*!
 * @brief free the internal array of a `DynamicArray`.
 *
 * @param da non-null pointer to the `DynamicArray`.
 * @param data_free function that can free elements in the array.
 */
void DYNAMICARRAY_METHODNAME(clear)(
	DYNAMICARRAY_TAG *const restrict da,
	DA_CONCAT(free_mem_, DYNAMICARRAY_UNIQUE_SUFFIX) * data_free
)
{
	if (!da)
		return;

	if (data_free && da->used <= da->capacity)
	{
		for (len_ty i = 0; i < da->used; i++)
			data_free(da->arr[i]);
	}

	da->arr = xfree(da->arr);
	*da = (DYNAMICARRAY_TAG){0};
}

/*!
 * @brief allocate memory for the internal array of a `DynamicArray`.
 *
 * @param da non-null pointer to the `DynamicArray`.
 * @param capacity positive non-zero size of the internal array.
 * @returns true on success, false on error.
 */
bool DYNAMICARRAY_METHODNAME(init)(
	DYNAMICARRAY_TAG *const restrict da, const len_ty capacity
)
{
	if (!da || capacity < 1)
		return (false);

	*da = (DYNAMICARRAY_TAG){0};
	da->arr = xmalloc(sizeof(*(da->arr)) * capacity);
	if (!da->arr)
		return (false);

	da->capacity = capacity;
	return (true);
}

/*!
 * @brief free a `DynamicArray`.
 *
 * @param da non-null pointer to the `DynamicArray`.
 * @param data_free function that can free elements in the array.
 * @returns NULL always.
 */
void *DYNAMICARRAY_METHODNAME(del)(
	DYNAMICARRAY_TAG *const restrict da,
	DA_CONCAT(free_mem_, DYNAMICARRAY_UNIQUE_SUFFIX) * data_free
)
{
	DYNAMICARRAY_METHODNAME(clear)(da, data_free);
	return (xfree(da));
}

/*!
 * @brief allocate memory for a `DynamicArray`.
 *
 * @param capacity positive non-zero size of the internal array.
 * @returns pointer to the `DynamicArray`, NULL on error.
 */
DYNAMICARRAY_TAG *DYNAMICARRAY_METHODNAME(new)(const len_ty capacity)
{
	if (capacity < 1)
		return (NULL);

	DYNAMICARRAY_TAG *const restrict da = xmalloc(sizeof(*da));

	if (!da)
		return (NULL);

	if (DYNAMICARRAY_METHODNAME(init)(da, capacity) == false)
		return (xfree(da));

	return (da);
}

/*!
 * @brief expand the capacity of a `DynamicArray` to fit a given size.
 *
 * The `DynamicArray` will be cleared on error.
 *
 * @param da non-null pointer to the `DynamicArray`.
 * @param capacity positive non-zero size to the expand the internal array to.
 * @param data_free function that can free elements in the array.
 * @returns pointer to the `DynamicArray`, NULL on error.
 */
DYNAMICARRAY_TAG *DYNAMICARRAY_METHODNAME(grow)(
	DYNAMICARRAY_TAG *const restrict da, const len_ty capacity,
	DA_CONCAT(free_mem_, DYNAMICARRAY_UNIQUE_SUFFIX) * data_free
)
{
	if (!da || capacity < 1 || da->capacity < 0)
		goto error_cleanup;

	if (capacity <= da->capacity)
		return (da);

	DYNAMICARRAY_DATATYPE *const restrict arr =
		xrealloc(da->arr, sizeof(*arr) * capacity);

	if (!arr)
		goto error_cleanup;

	da->arr = arr;
	da->capacity = capacity;
	return (da);
error_cleanup:
	DYNAMICARRAY_METHODNAME(clear)(da, data_free);
	return (NULL);
}

/*!
 * @brief validate the state of a `DynamicArray`.
 *
 * @param da the `DynamicArray`.
 * @returns true if the `DynamicArray` is in a valid state, false otherwise.
 */
static bool DYNAMICARRAY_METHODNAME(isvalid)(const DYNAMICARRAY_TAG da)
{
	return (
		da.arr && da.capacity > 0 && 0 <= da.used && da.used <= da.capacity
	);
}

/*!
 * @brief return the address of the slot at given index in the array.
 *
 * @param da non-null pointer to the `DynamicArray`.
 * @param idx positive index to retrieve.
 * @returns pointer to the slot at index `idx` in the array, NULL on error.
 */
DYNAMICARRAY_DATATYPE *DYNAMICARRAY_METHODNAME(get)(
	DYNAMICARRAY_TAG *const restrict da, const len_ty idx
)
{
	if (!da || idx < 0 || !DYNAMICARRAY_METHODNAME(isvalid)(*da) ||
		idx >= da->used)
		return (NULL);

	return (da->arr + idx);
}

/*!
 * @brief insert slots into a `DynamicArray` at a given index by shifting
 * elements after the index to the right.
 *
 * Slots can only be inserted within the range of the beginning of the array
 * to the largest used index.
 * The `DynamicArray` must have enough capacity to hold the added slots.
 *
 * @param da non-null pointer to the `DynamicArray` to modify.
 * @param at_i positive index to insert slots at.
 * @param n positive non-zero number of slots to insert.
 * @returns pointer to the first slot inserted, NULL on error.
 */
DYNAMICARRAY_DATATYPE *DYNAMICARRAY_METHODNAME(slots_insert)(
	DYNAMICARRAY_TAG *const restrict da, const len_ty at_i,
	const len_ty n
)
{
	DYNAMICARRAY_DATATYPE *const restrict start =
		DYNAMICARRAY_METHODNAME(get)(da, at_i);

	if (!start || n < 1 || da->used + n > da->capacity)
		return (NULL);

	DYNAMICARRAY_DATATYPE *const restrict end = start + n;

	memmove(end, start, sizeof(DYNAMICARRAY_DATATYPE) * (da->used - at_i));
	da->used += n;
	return (start);
}

/*!
 * @brief remove slots from a `DynamicArray` at a given index by shifting
 * elements after the index to the left.
 *
 * Only slots within the range of the beginning of the array to the largest
 * used index can be removed.
 *
 * @param da pointer to the `DynamicArray` to modify.
 * @param at_i index of the first slot to remove.
 * @param n positive non-zero number of slots to remove.
 * @param data_free function that can free elements in the slots.
 * @returns pointer to the first edited slot, NULL on error.
 */
DYNAMICARRAY_DATATYPE *DYNAMICARRAY_METHODNAME(slots_remove)(
	DYNAMICARRAY_TAG *const restrict da, const len_ty at_i,
	const len_ty n,
	DA_CONCAT(free_mem_, DYNAMICARRAY_UNIQUE_SUFFIX) * data_free
)
{
	DYNAMICARRAY_DATATYPE *const restrict start =
		DYNAMICARRAY_METHODNAME(get)(da, at_i);

	if (!start || n < 1 || at_i + n > da->used)
		return (NULL);

	DYNAMICARRAY_DATATYPE *const restrict end = start + n;

	if (data_free)
	{
		for (DYNAMICARRAY_DATATYPE *i = start; i < end; i++)
			data_free(*i);
	}

	memmove(start, end, sizeof(DYNAMICARRAY_DATATYPE) * (da->used - at_i - n));
	da->used -= n;
	return (start);
}

/*!
 * @brief insert a value into a `DynamicArray` at the given index.
 *
 * On failure, the array will be cleared.
 * The array will grow as necessary to accommodate the insert.
 * Usd slots will not be overwritten; elements will be shifted to the right to
 * accommodate the insert.
 * If the given index is greater than the currently used slots, the used slots
 * counter will be updated to `idx + 1` and any skipped slots will not be
 * initialised.
 *
 * @param da non-null pointer to the `DynamicArray`.
 * @param data data to insert.
 * @param idx positive index to insert at.
 * @returns pointer to the newly inserted data, NULL on failure.
 */
DYNAMICARRAY_DATATYPE *DYNAMICARRAY_METHODNAME(insert)(
	DYNAMICARRAY_TAG *const restrict da, DYNAMICARRAY_DATATYPE data,
	const len_ty idx,
	DA_CONCAT(free_mem_, DYNAMICARRAY_UNIQUE_SUFFIX) * data_free
)
{
	if (!da || idx < 0 || da->capacity < 0 || da->used < 0)
		goto error_cleanup;

	size_t used_slots = (size_t)idx + 1;

	if (used_slots > (size_t)da->capacity)
	{
		if (used_slots <= 1U << 7)
			used_slots *= 2;
		else
			used_slots += used_slots >> 2;

		if (used_slots > (size_t)LEN_TY_max || used_slots < (size_t)idx + 1)
			goto error_cleanup;

		if (!DYNAMICARRAY_METHODNAME(grow)(da, used_slots, data_free))
			return (NULL);
	}

	if (da->used <= idx)
		da->used = idx + 1;
	else
		DYNAMICARRAY_METHODNAME(slots_insert)(da, idx, 1);

	da->arr[idx] = data;
	return (da->arr + idx);
error_cleanup:
	DYNAMICARRAY_METHODNAME(clear)(da, data_free);
	return (NULL);
}

/*!
 * @brief remove a value from a `DynamicArray`.
 *
 * Elements in the array will be shifted to fill the gap left by the remove.
 *
 * @param da non-null pointer to the `DynamicArray`.
 * @param idx positive index of the value to remove.
 * @returns true on success, false on error.
 */
bool DYNAMICARRAY_METHODNAME(remove)(
	DYNAMICARRAY_TAG *const restrict da, const len_ty idx
)
{
	if (!DYNAMICARRAY_METHODNAME(get)(da, idx))
		return (false);

	DYNAMICARRAY_METHODNAME(slots_remove)(da, idx, 1, NULL);
	return (true);
}

