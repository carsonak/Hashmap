TEST(hashing, test_invalid_inputs)
{
	hashval hash;

	/* clang-format off */
	CHECK(HASHMAP_METHOD(hash)(NULL, (u8mem){.len = -1, .buf = NULL}) == false);
	CHECK(HASHMAP_METHOD(hash)(NULL, (u8mem){.len = -1, .buf = (unsigned char *)1}) == false);
	CHECK(HASHMAP_METHOD(hash)(NULL, (u8mem){.len = 1, .buf = NULL}) == false);
	CHECK(HASHMAP_METHOD(hash)(NULL, (u8mem){.len = 1, .buf = (unsigned char *)1}) == false);
	CHECK(HASHMAP_METHOD(hash)(&hash, (u8mem){.len = -1, .buf = (unsigned char *)1}) == false);
	CHECK(HASHMAP_METHOD(hash)(&hash, (u8mem){.len = 0, .buf = (unsigned char *)1}) == false);
	CHECK(HASHMAP_METHOD(hash)(&hash, (u8mem){.len = 1, .buf = NULL}) == false);
	CHECK(HASHMAP_METHOD(hash)(&hash, (u8mem){.len = 0, .buf = NULL}) == false);
	CHECK(HASHMAP_METHOD(hash)(&hash, (u8mem){.len = -1, .buf = NULL}) == false);
	/* clang-format on */
}

TEST(hashing, test_same_input_same_output)
{
	unsigned char mem[] = {1, 2, 3, 4, 5, 6, 7, 8, 9, 0, 123};
	hashval h1, h2;

	/* clang-format off */
	REQUIRE(HASHMAP_METHOD(hash)(&h1, (u8mem){.len=sizeof(mem)/sizeof(*mem), .buf=mem}) == true);
	REQUIRE(HASHMAP_METHOD(hash)(&h2, (u8mem){.len=sizeof(mem)/sizeof(*mem), .buf=mem}) == true);
	/* clang-format on */
	CHECK(h1 == h2);
}

