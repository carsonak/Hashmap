    int line;
    uLong crc;
    char* buf;
    int len;
    uLong expect;
} crc32_test;

void test_crc32(crc, buf, len, chk, line)
    uLong crc;
    Byte *buf;
    z_size_t len;
    uLong chk;
    int line;
{
    uLong res = crc32(crc, buf, len);
    if (res != chk) {
        fprintf(stderr, "FAIL [%d]: crc32 returned 0x%08X expected 0x%08X\n",
                line, (unsigned int)res, (unsigned int)chk);
        exit(1);
    }
}

