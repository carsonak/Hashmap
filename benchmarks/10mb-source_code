sub filter {
    my ($self, %opts) = @_;
    my $remove = $opts{remove} // sub { 0 };
    my $keep = $opts{keep} // sub { 1 };

    @{$self->{options}} = grep { not $remove->($_) and $keep->($_) }
                               @{$self->{options}};
}

