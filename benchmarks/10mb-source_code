TEST(expanding, test_invalid_arguments)
{
	CHECK_PTR_EQ(hashmap_grow(NULL, -1), NULL);
	CHECK_PTR_EQ(hashmap_grow(NULL, 0), NULL);
	CHECK_PTR_EQ(hashmap_grow(NULL, 1), NULL);
	/* clang-format off */
	CHECK_PTR_EQ(hashmap_grow(&(HashMap){.capacity = -1, .used = -1, .arr = (Bucket *)1}, 1), NULL);
	CHECK_PTR_EQ(hashmap_grow(&(HashMap){.capacity = 0, .used = -1, .arr = (Bucket *)1}, 1), NULL);
	CHECK_PTR_EQ(hashmap_grow(&(HashMap){.capacity = 1, .used = -1, .arr = (Bucket *)1}, 1), NULL);
	CHECK_PTR_EQ(hashmap_grow(&(HashMap){.capacity = 1, .used = 0, .arr = (Bucket *)1}, -1), NULL);
	CHECK_PTR_EQ(hashmap_grow(&(HashMap){.capacity = 1, .used = 0, .arr = NULL}, 1), NULL);
#ifdef CELLAR_COALESCED_HASHING
	CHECK_PTR_EQ(hashmap_grow(&(HashMap){.capacity = 1, .used = 0, .arr = (Bucket *)1, .cellar = (Cellar){.capacity = -1, .used = -1, .arr = NULL}}, -1), NULL);
	CHECK_PTR_EQ(hashmap_grow(&(HashMap){.capacity = 1, .used = 0, .arr = (Bucket *)1, .cellar = (Cellar){.capacity = 0, .used = -1, .arr = (Bucket *)1}}, -1), NULL);
	CHECK_PTR_EQ(hashmap_grow(&(HashMap){.capacity = 1, .used = 0, .arr = (Bucket *)1, .cellar = (Cellar){.capacity = 1, .used = -1, .arr = (Bucket *)1}}, -1), NULL);
	CHECK_PTR_EQ(hashmap_grow(&(HashMap){.capacity = 1, .used = 0, .arr = (Bucket *)1, .cellar = (Cellar){.capacity = 1, .used = 1, .arr = NULL}}, -1), NULL);
	/* clang-format on */
#endif /* CELLAR_COALESCED_HASHING */
}

TEST(expanding, test_no_growth)
{
	HashMap input = {.capacity = 8, .arr = (Bucket *)1};

	CHECK_PTR_EQ(hashmap_grow(&input, input.capacity / 2), &input);
	CHECK_PTR_EQ(hashmap_grow(&input, input.capacity), &input);
}

TEST_F(expanding, test_growing_a_hashmap)
{
	const len_ty initial_capacity = tau->input->capacity;
#ifdef CELLAR_COALESCED_HASHING
	const len_ty initial_cellar_capacity = tau->input->cellar.capacity;
#endif /* CELLAR_COALESCED_HASHING */
	HashMap *const restrict ouput =
		hashmap_grow(tau->input, tau->input->capacity * 2);

	REQUIRE_PTR_NE(ouput, NULL);
	tau->input = ouput;
	CHECK(tau->input->capacity == initial_capacity * 2);
#ifdef CELLAR_COALESCED_HASHING
	CHECK(tau->input->cellar.capacity >= initial_cellar_capacity * 2);
#endif /* CELLAR_COALESCED_HASHING */
}
