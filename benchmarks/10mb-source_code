	___DEPRECATED(GET_SCAN_MEDIA, "Get Scan Media Results"),          \
	___C(GET_TIMESTAMP, "Get Timestamp"),                             \
	___C(MAX, "invalid / last command")

#define ___C(a, b) CXL_MEM_COMMAND_ID_##a
