struct expanding
{
	HashMap_int *restrict input;
};

TEST_F_SETUP(expanding)
{
	tau->input = HASHMAP_METHOD(new)(16);
	REQUIRE_PTR_NE(tau->input, NULL);
}

TEST_F_TEARDOWN(expanding)
{
	tau->input = HASHMAP_METHOD(delete)(tau->input, NULL);
}

TEST(expanding, test_invalid_arguments)
{
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(NULL, -1), NULL);
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(NULL, 0), NULL);
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(NULL, 1), NULL);
	/* clang-format off */
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(&(HashMap_int){.capacity = -1, .used = -1, .arr = (BUCKET_TAG *)1}, 1), NULL);
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(&(HashMap_int){.capacity = 0, .used = -1, .arr = (BUCKET_TAG *)1}, 1), NULL);
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(&(HashMap_int){.capacity = 1, .used = -1, .arr = (BUCKET_TAG *)1}, 1), NULL);
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(&(HashMap_int){.capacity = 1, .used = 0, .arr = (BUCKET_TAG *)1}, -1), NULL);
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(&(HashMap_int){.capacity = 1, .used = 0, .arr = NULL}, 1), NULL);
#ifdef CELLAR_COALESCED_HASHING
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(&(HashMap_int){.capacity = 1, .used = 0, .arr = (BUCKET_TAG *)1, .cellar = (CELLAR_TAG){.capacity = -1, .used = -1, .arr = NULL}}, -1), NULL);
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(&(HashMap_int){.capacity = 1, .used = 0, .arr = (BUCKET_TAG *)1, .cellar = (CELLAR_TAG){.capacity = 0, .used = -1, .arr = (BUCKET_TAG *)1}}, -1), NULL);
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(&(HashMap_int){.capacity = 1, .used = 0, .arr = (BUCKET_TAG *)1, .cellar = (CELLAR_TAG){.capacity = 1, .used = -1, .arr = (BUCKET_TAG *)1}}, -1), NULL);
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(&(HashMap_int){.capacity = 1, .used = 0, .arr = (BUCKET_TAG *)1, .cellar = (CELLAR_TAG){.capacity = 1, .used = 1, .arr = NULL}}, -1), NULL);
	/* clang-format on */
#endif /* CELLAR_COALESCED_HASHING */
}

TEST(expanding, test_no_growth)
{
	HashMap_int input = {.capacity = 8, .arr = (BUCKET_TAG *)1};

	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(&input, input.capacity / 2), &input);
	CHECK_PTR_EQ(HASHMAP_METHOD(grow)(&input, input.capacity), &input);
}

TEST_F(expanding, test_growing_a_hashmap)
{
	const len_ty initial_capacity = tau->input->capacity;
#ifdef CELLAR_COALESCED_HASHING
	const len_ty initial_cellar_capacity = tau->input->cellar.capacity;
#endif /* CELLAR_COALESCED_HASHING */
	HashMap_int *const restrict ouput =
		HASHMAP_METHOD(grow)(tau->input, tau->input->capacity * 2);

	REQUIRE_PTR_NE(ouput, NULL);
	tau->input = ouput;
	CHECK(tau->input->capacity == initial_capacity * 2);
#ifdef CELLAR_COALESCED_HASHING
	CHECK(tau->input->cellar.capacity >= initial_cellar_capacity * 2);
#endif /* CELLAR_COALESCED_HASHING */
}
