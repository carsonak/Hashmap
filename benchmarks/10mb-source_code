#ifdef CELLAR_COALESCED_HASHING
	CHECK_PTR_EQ(hm_int_grow(&(HashMap_int){.capacity = 1, .used = 0, .cellar = (Cellar_int){.capacity = -1, .used = -1, .arr = NULL}}, -1), NULL);
