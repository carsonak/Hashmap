TEST(hashmap_creation, test_invalid_capacities)
{
	CHECK_PTR_EQ(hashmap_new(-1), NULL);
	CHECK_PTR_EQ(hashmap_new(0), NULL);
	CHECK_PTR_EQ(hashmap_new(LEN_TY_min), NULL);
	CHECK_PTR_EQ(hashmap_new(LEN_TY_max), NULL);
